{
  "name": "preread",
  "version": "0.1.0",
  "private": true,
  "description": "Read what your coding agents wrote before it becomes a pull request.",
  "license": "MIT",
  "author": "Josh Matz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshmatz/preread.git"
  },
  "homepage": "https://github.com/joshmatz/preread#readme",
  "bugs": "https://github.com/joshmatz/preread/issues",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 tsx --test tests/*.test.ts",
    "collection": "tsx scripts/collections.ts",
    "refresh": "tsx scripts/refresh.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "diff2html": "^3.4.52",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
